' Oraculo grafico 3: PUT com PSET/AND/OR/PRESET, PALETTE e arcos de CIRCLE.
SCREEN 9
DIM arr(2000) AS INTEGER
LINE (20, 20)-(30, 30), 5, BF
GET (20, 20)-(30, 30), arr
LINE (100, 100)-(110, 110), 7, BF
PUT (100, 100), arr, PSET
OPEN "GFXRES.TXT" FOR OUTPUT AS #1
PRINT #1, "pset"; POINT(105, 105); POINT(99, 99)
LINE (100, 100)-(110, 110), 7, BF
PUT (100, 100), arr, AND
PRINT #1, "and"; POINT(105, 105)
LINE (100, 100)-(110, 110), 2, BF
PUT (100, 100), arr, OR
PRINT #1, "or"; POINT(105, 105)
LINE (100, 100)-(110, 110), 7, BF
PUT (100, 100), arr, PRESET
PRINT #1, "preset"; POINT(105, 105)
PALETTE 5, 9
PRINT #1, "palette"; POINT(25, 25); POINT(105, 105)
CIRCLE (200, 150), 40, 4, 0, 1.5707963
PRINT #1, "arco"; POINT(240, 150); POINT(160, 150); POINT(200, 110); POINT(200, 190)
CIRCLE (300, 150), 30, 6, 3.14159, 4.71238
PRINT #1, "arco2"; POINT(270, 150); POINT(330, 150)
CLOSE #1
SCREEN 0
