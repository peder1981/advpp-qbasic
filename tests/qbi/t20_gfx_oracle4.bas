' Oraculo grafico 4: modos 1, 2 e 12 (pixels, circulo vertical).
OPEN "GFXRES.TXT" FOR OUTPUT AS #1
SCREEN 1
PSET (10, 10), 2
PRINT #1, "m1"; POINT(10, 10); POINT(11, 10); POINT(319, 199)
CIRCLE (160, 100), 50, 3
FOR y = 30 TO 170
  IF POINT(160, y) = 3 THEN PRINT #1, "m1up"; y
NEXT y
SCREEN 2
PSET (5, 5), 1
PRINT #1, "m2"; POINT(5, 5); POINT(6, 5); POINT(639, 199)
SCREEN 12
PSET (300, 200), 9
LINE (100, 100)-(200, 150), 12
PRINT #1, "m12"; POINT(300, 200); POINT(150, 125); POINT(639, 479)
CIRCLE (320, 240), 100, 10
FOR y = 100 TO 380
  IF POINT(320, y) = 10 THEN PRINT #1, "m12up"; y
NEXT y
CLOSE #1
SCREEN 0
